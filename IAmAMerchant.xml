            <Button name="IAAM_NextPageButton">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="IAAM_Frame" relativePoint="BOTTOMLEFT" x="316" y="48"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString inherits="GameFontNormal" justifyH="RIGHT" text="NEXT">
                            <Anchors>
                                <Anchor point="RIGHT" relativeTo="IAAM_NextPageButton" relativePoint="LEFT" x="-3" y="0"/>
                            </Anchors>
                        </FontString>
                        <Texture file="Interface\Buttons\UI-PageButton-Background">
                            <Size x="32" y="32"/>
                            <Anchors>
                                <Anchor point="CENTER" x="0" y="1"/>
