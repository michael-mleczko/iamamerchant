<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">

    <!-- Load Core LUA script -->

    <Script File="IAAM_Frame.lua" />

    <!-- Vendor Button Frame -->

    <Frame name="IAAM_VendorButtonFrame" toplevel="true" movable="true" resizable="false" enableMouse="false" parent="UIParent" hidden="true">
        <!-- This frame just serves as a container -->
        <Size>
            <AbsDimension x="1" y="1" />
        </Size>
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>
        <Frames>
            <!-- Frame used to move the parent frame -->
            <Frame name="$parent_DragFrame" frameStrata="DIALOG" >
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="IAAM_VendorButtonFrame" relativePoint="TOPLEFT" x="-10" y="10"/>
                </Anchors>
                <Size x="24" y="24"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parent_DragFrameTexture" file="Interface\Buttons\LockButton-Border" />
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        IAAM_VendorButtonFrame:StartMoving()
                    </OnMouseDown>
                    <OnMouseUp>
                        IAAM_VendorButtonFrame:StopMovingOrSizing()
                    </OnMouseUp>
                </Scripts>
            </Frame>
            <!-- Button to open vendor window -->
            <Button name="$parent_Button" >
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="IAAM_VendorButtonFrame" relativePoint="TOPLEFT" x="0" y="0"/>
                </Anchors>
                <Size x="64" y="64"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parent_ButtonTexture2" file="Interface\COMMON\BlueMenuRing" >
                            <Size x="120" y="120"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-16" y="16"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND">
                        <Texture name="$parent_ButtonTexture1" file="Interface\MERCHANTFRAME\UI-BuyBack-Icon" />
                    </Layer>
                </Layers>
                <Scripts>
                    <OnMouseDown>
                        IAAM_FRAME_OpenTarget()
                    </OnMouseDown>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Merchant Frame -->

    <Frame name="IAAM_Frame" inherits="ButtonFrameTemplate" toplevel="true" movable="true" resizable="false" enableMouse="true" parent="UIParent" hidden="true" >
        <Size>
            <AbsDimension x="340" y="444" />
        </Size>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0" />
        </Anchors>
        <Layers>
            <Layer level="BORDER">
                <FontString name="IAAM_Frame_Page" inherits="GameFontNormal" text="">
                    <Size x="104" y="0"/>
                    <Anchors>
                        <Anchor point="BOTTOM" x="0" y="42"/>
                    </Anchors>
                </FontString>
                <FontString name="IAAM_Frame_Title" inherits="GameFontNormal" text="MerchantName">
                    <Size x="250" y="0"/>
                    <Anchors>
                        <Anchor point="TOP" x="15" y="-5"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnHide>
            </OnHide>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
            <OnHide function="IAAM_FRAME_OnHide"/>
            <OnLoad function="IAAM_FRAME_OnLoad"/>
            <OnShow function="IAAM_FRAME_OnShow"/>
            <OnMouseDown function="IAAM_FRAME_OnMouseDown"/>
            <OnUpdate function="IAAM_FRAME_OnUpdate"/>
            <OnMouseWheel function="IAAM_FRAME_OnMouseWheel"/>
            <OnReceiveDrag function="IAAM_FRAME_OnReceiveDrag"/>
            <OnEvent function="IAAM_EVENT_GlobalHandler" />
        </Scripts>
        <Frames>
            <Frame name="IAAM_Frame_Item1" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="13" y="-69"/>
                </Anchors>
            </Frame>
            <Frame name="IAAM_Frame_Item2" inherits="MerchantItemTemplate" hidden="true">
