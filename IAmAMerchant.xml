            </Frame>
            <Frame name="IAAM_MoneyFrame" inherits="SmallMoneyFrameTemplate">
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeTo="IAAM_Frame" relativePoint="BOTTOMRIGHT" x="-4" y="7"/>
                </Anchors>
            </Frame>
            <Button name="IAAM_PrevPageButton">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="IAAM_Frame" relativePoint="BOTTOMLEFT" x="25" y="48"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString inherits="GameFontNormal" justifyH="LEFT" text="PREV">
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="IAAM_PrevPageButton" relativePoint="RIGHT"/>
                            </Anchors>
                        </FontString>
                        <Texture file="Interface\Buttons\UI-PageButton-Background">
                            <Size x="32" y="32"/>
