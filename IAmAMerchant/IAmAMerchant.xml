            <AbsDimension x="340" y="444" />
        </Size>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0" />
        </Anchors>
		<Layers>
			<Layer level="BORDER">
				<FontString name="IAAM_MerchantFrame_Page" inherits="GameFontNormal" text="">
					<Size x="104" y="0"/>
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="42"/>
					</Anchors>
				</FontString>
			</Layer>
        </Layers>
        <Scripts>
            <OnHide>
            </OnHide>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
			<OnHide function="IAAM_MerchantFrame_OnHide"/>
			<OnLoad function="IAAM_MerchantFrame_OnLoad"/>
			<OnShow function="IAAM_MerchantFrame_OnShow"/>
			<OnUpdate function="IAAM_MerchantFrame_OnUpdate"/>
			<OnMouseWheel function="IAAM_MerchantFrame_OnMouseWheel"/>
            <OnEvent function="IAAM_MerchantFrame_EventHandler" />
        </Scripts>
