<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
    
    <!-- Load Core LUA script -->
    
    <Script File="IAmAMerchant.lua" />
    
    <!-- Merchant Frame -->
    
    <Frame name="IAAM_MerchantFrame" inherits="ButtonFrameTemplate" toplevel="true" movable="true" resizable="false" enableMouse="true" parent="UIParent" hidden="true" >
