<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

	<Script file="IAAM_MerchantTracker.lua"/>

	<!--
		Merchant Tracker

		Compact list of other IAmAMerchant users, in the style of the modern
		group loot history window (DefaultPanelFlatTemplate):

		  [ Search names            ] [Refresh]
		  | Bob Builder        30 items
		  | Anna Smith          3 items
		  Not reachable
		  | Cain Dogfang      no connection
		  2 merchants, 1 not reachable
	-->

	<!-- One row of the list: a merchant, another addon user, or a section header -->
	<Button name="IAAM_MT_RowTemplate" mixin="IAAM_MT_RowMixin" registerForClicks="LeftButtonUp" virtual="true">
		<Size y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Stripe" atlas="auctionhouse-rowstripe-1" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<!-- Thin bar on the left: green for reachable merchants, grey for others -->
				<Texture parentKey="StatusBar">
					<Size x="3"/>
					<Anchors>
						<Anchor point="TOPLEFT" y="-3"/>
						<Anchor point="BOTTOMLEFT" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="RightLabel" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-6"/>
					</Anchors>
				</FontString>
				<FontString parentKey="LeftLabel" inherits="GameFontHighlightSmall" wordwrap="false" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="10"/>
						<Anchor point="RIGHT" relativeKey="$parent.RightLabel" relativePoint="LEFT" x="-6"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<HighlightTexture parentKey="Highlight" atlas="auctionhouse-ui-row-highlight" alphaMode="ADD" setAllPoints="true"/>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Frame name="IAAM_MT" mixin="IAAM_MT_Mixin" inherits="DefaultPanelFlatTemplate" parent="UIParent" toplevel="true" frameStrata="MEDIUM" movable="true" resizable="true" enableMouse="true" registerForDrag="LeftButton" clampedToScreen="true" hidden="true">
		<Size x="250" y="300"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<ResizeBounds>
			<minResize x="250" y="160"/>
			<maxResize x="250" y="700"/>
		</ResizeBounds>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
		<Layers>
			<Layer level="OVERLAY">
				<!-- Summary below the list -->
				<FontString parentKey="Status" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="14" y="10"/>
						<Anchor point="BOTTOMRIGHT" x="-14" y="10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="ClosePanelButton" inherits="UIPanelCloseButtonDefaultAnchors"/>

			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate">
				<Size y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="18" y="-30"/>
					<Anchor point="TOPRIGHT" x="-40" y="-30"/>
				</Anchors>
			</EditBox>

			<!-- Same refresh button as in the group finder -->
			<Button parentKey="RefreshButton">
				<Size x="28" y="28"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.SearchBox" relativePoint="RIGHT" x="2" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<Texture parentKey="Icon" file="Interface\Buttons\UI-RefreshButton">
							<Size x="14" y="14"/>
							<Anchors>
								<Anchor point="CENTER" x="-1" y="0"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<NormalTexture file="Interface\Buttons\UI-SquareButton-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SquareButton-Down"/>
				<DisabledTexture file="Interface\Buttons\UI-SquareButton-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>

			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT" x="10" y="-58"/>
					<Anchor point="BOTTOMRIGHT" x="-22" y="26"/>
				</Anchors>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="6" y="0"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="6" y="0"/>
				</Anchors>
			</EventFrame>

			<!-- Shown when the list is empty -->
			<Frame parentKey="EmptyText" setAllPoints="false">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontDisableSmall" justifyH="CENTER">
							<Anchors>
								<Anchor point="LEFT" x="10"/>
								<Anchor point="RIGHT" x="-10"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<!-- Grip at the bottom edge to change the height -->
			<Button parentKey="ResizeButton" frameLevel="600">
				<Size x="32" y="12"/>
				<Anchors>
					<Anchor point="TOP" relativePoint="BOTTOM" x="0" y="3"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<Texture atlas="lootroll-resizehandle" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Button>
		</Frames>
	</Frame>

</Ui>
