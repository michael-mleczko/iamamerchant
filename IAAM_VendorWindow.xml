<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <!-- Load LUA script -->
    <Script file="IAAM_VendorWindow.lua"/>

    <!-- Extension for the AddItemPopup -->
    <Frame name="IAAM_PopupExtension"  enableMouse="true" toplevel="true" hidden="true">
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
        <Size x="240" y="60"/>
        <Layers>
            <Layer level="OVERLAY">
                <!-- First Label -->
                <FontString parentKey="Label1" text="Stack Size:" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="TOP" y="-20"/>
                    </Anchors>
                </FontString>
                <!-- Second Label -->
                <FontString parentKey="Label2" text="Stack Price:" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="TOP" y="-45"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- First Edit Box -->
            <EditBox parentKey="EditBox1" numeric="true" autoFocus="false" inherits="InputBoxTemplate">
                <Size x="100" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Label1" relativePoint="RIGHT" x="10"/>
                </Anchors>
            </EditBox>
            <!-- Second Edit Box -->
            <EditBox parentKey="EditBox2" numeric="true" autoFocus="true" inherits="InputBoxTemplate">
                <Size x="100" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Label2" relativePoint="RIGHT" x="10"/>
                </Anchors>
            </EditBox>
        </Frames>
    </Frame>

    <!-- Vendor Window Frame -->
    <Frame name="IAAM_VW" inherits="ButtonFrameTemplate" toplevel="true" movable="true" resizable="false" enableMouse="true" parent="UIParent" hidden="true" >
        <Size>
            <AbsDimension x="340" y="444"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="BORDER">
                <FontString parentKey="FontStringPage" inherits="GameFontNormal" text="">
                    <Size x="104" y="0"/>
                    <Anchors>
                        <Anchor point="BOTTOM" x="0" y="42"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="FontStringTitle" inherits="GameFontNormal" text="MerchantName">
                    <Size x="250" y="0"/>
                    <Anchors>
                        <Anchor point="TOP" x="15" y="-5"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnDragStart method="StartMoving"/>
            <OnDragStop method="StopMovingOrSizing"/>
            <OnLoad>
                IAAM.VW.OnLoad(self)
            </OnLoad>
        </Scripts>
        <Frames>
            <Frame parentKey="FrameItem1" name="$parentFrameItem1" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="13" y="-69"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem2" name="$parentFrameItem2" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem1" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem3" name="$parentFrameItem3" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem1" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem4" name="$parentFrameItem4" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem3" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem5" name="$parentFrameItem5" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem3" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem6" name="$parentFrameItem6" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem5" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem7" name="$parentFrameItem7" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem5" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem8" name="$parentFrameItem8" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem7" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem9" name="$parentFrameItem9" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem7" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem10" name="$parentFrameItem10" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem9" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem11" name="$parentFrameItem11" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem9" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameItem12" name="$parentFrameItem12" inherits="MerchantItemTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.FrameItem11" relativePoint="TOPRIGHT" x="12" y="0"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameMoneyInset" inherits="InsetFrameTemplate" useParentLevel="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMRIGHT" x="-171" y="27"/>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-5" y="4"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameMoneyBg" inherits="ThinGoldEdgeTemplate" >
                <Size x="120" y="30"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-7" y="25"/>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="-166" y="6"/>
                </Anchors>
            </Frame>
            <Frame parentKey="FrameMoney" name="$parent_FrameMoney" inherits="SmallMoneyFrameTemplate"> <!-- Template requires a name. Else Show() method fails. -->
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" relativeTo="IAAM_VW" relativePoint="BOTTOMRIGHT" x="-4" y="7"/>
                </Anchors>
            </Frame>
            <Button parentKey="PrevPageButton">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="25" y="48"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString inherits="GameFontNormal" justifyH="LEFT" text="PREV">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="RIGHT"/>
                            </Anchors>
                        </FontString>
                        <Texture file="Interface\Buttons\UI-PageButton-Background">
                            <Size x="32" y="32"/>
                            <Anchors>
                                <Anchor point="CENTER" x="0" y="1"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button parentKey="NextPageButton">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="316" y="48"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString inherits="GameFontNormal" justifyH="RIGHT" text="NEXT">
                            <Anchors>
                                <Anchor point="RIGHT" relativeKey="$parent" relativePoint="LEFT" x="-3" y="0"/>
                            </Anchors>
                        </FontString>
                        <Texture file="Interface\Buttons\UI-PageButton-Background">
                            <Size x="32" y="32"/>
                            <Anchors>
                                <Anchor point="CENTER" x="0" y="1"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
        </Frames>
    </Frame>
</Ui>